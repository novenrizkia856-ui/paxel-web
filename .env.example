# Optional build time values. All of them end up in the browser bundle: public values only.
# Defaults live in config/solana.config.js. Leave a value empty to keep the default.

# Solana cluster: mainnet-beta, devnet or testnet.
VITE_SOLANA_NETWORK=mainnet-beta

# JSON RPC endpoint, for example a managed provider URL. Empty uses the default in config/solana.config.js.
VITE_SOLANA_RPC_URL=

# Explorer base URL. Links add ?cluster= off mainnet.
VITE_SOLANA_EXPLORER_URL=https://explorer.solana.com

# Paxel program id. Leave empty: no Paxel program is deployed.
VITE_PAXEL_PROGRAM_ID=

# Paxel SPL token mint address. Leave empty until the token exists.
VITE_PAXEL_TOKEN_MINT=

# Paxel treasury public key. Leave empty until one is set.
VITE_TREASURY_ADDRESS=
