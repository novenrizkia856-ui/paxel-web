# Optional build time values. All of them end up in the browser bundle: public values only.

# Reown (WalletConnect) project id. The Paxel id is already set in assets/js/app/wallet-config.js.
VITE_WALLETCONNECT_PROJECT_ID=

# RPC override for Robinhood Chain, for example a managed provider URL.
VITE_RPC_URL=
